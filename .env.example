PORT=4000
APP_NAME=Starter App
DATABASE_URL=postgres://app:change-me@db.internal:5432/app?sslmode=require
MIGRATE_ON_START=true
DATABASE_POOL_SIZE=10
MAX_IN_FLIGHT_REQUESTS=100
SECRET_KEY_BASE=generate-with-openssl-rand-base64-64
CORS_ALLOWED_ORIGINS=https://app.example.com,http://localhost:5173
EMAIL_BACKEND=smtp
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_FROM=Starter App <no-reply@example.com>
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe-123
